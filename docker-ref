#create a file named Dockerfile inside vscode
FROM nginx:alpine
COPY . /usr/share/nginx/html
#In terminal:
docker build -t sahaana18/chat-v1-app .  #docker build -t username /any_name .
docker push sahaana18/chat-v1-app         , # docker push username /any_name
#create a file v1-deployment.yaml:
apiVersion: apps/v1
kind: Deployment
metadata:
  name: chat-v1-deployment    # any- name-deployment
spec:
  replicas: 1
  selector:
    matchLabels:
      app: chat-v1-app   #  image name
  template:
    metadata:
      labels:
        app: chat-v1-app   # image name
    spec:
      containers:
      - name: chat-v1-container   #any-name-container
        image: sahaana18/chat-v1-app     #dockerusername/imagename
        ports:
        - containerPort: 80 
   
  #Terminal:
kubectl apply -f v1-deployment.yaml    ,   (kubectl apply -f filename)

#create v1-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: chat-v1-service    #any-name-service
spec:
  type: NodePort
  selector:
    app: chat-v1-app     #imagename
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
    nodePort: 30011

#terminal:
kubectl apply -f v1-service.yaml     #kubectl apply -f file name
kubectl get services
kubectl port-forward service/chat-v1-service 30011:80  #  kubectl port-forward service/service-name 30011:80
